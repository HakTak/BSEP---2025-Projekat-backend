<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================================================
         PROPERTIES
    ============================================================ -->
    <property name="LOG_PATH"  value="./logs"/>
    <property name="APP_NAME"  value="pki-backend"/>

    <!-- ISO 8601 timestamp + structured fields za konzolu -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Isti pattern za obican app log fajl -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ============================================================
         APPENDER 1: Konzola (development / debugging)
    ============================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         APPENDER 2: Opšti aplikativni log (rotacija po veličini i datumu)
         - Novi fajl svakog dana
         - Max 10 MB po fajlu
         - Čuvanje 30 dana
         - Max 500 MB ukupno
    ============================================================ -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Arhiva: app-2025-06-01.0.log.gz -->
            <fileNamePattern>${LOG_PATH}/archived/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         APPENDER 3: Audit log (SAMO bezbednosni dogadjaji)
         - Poseban fajl za neporecivost (non-repudiation)
         - Stroža rotacija: 90 dana, max 1 GB ukupno
         - Samo AUDIT logger piše ovde
    ============================================================ -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/audit.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/audit-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <!-- Structured format: datum | eventId | eventType | userId | ip | result | poruka -->
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} | %X{eventId} | %X{eventType} | %X{userId} | %X{ipAddress} | %X{result} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         LOGGER KONFIGURACIJE
    ============================================================ -->

    <!-- Audit logger – piše SAMO u audit.log, ne propagira dalje -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Smanjujemo buku od Keycloak i Apache HTTP klijenta
         (zamenjujemo logging.level linije iz application.properties) -->
    <logger name="org.apache.http"              level="WARN"/>
    <logger name="org.keycloak.admin.client"    level="WARN"/>

    <!-- Hibernate SQL – korisno za dev, u produkciji staviti WARN -->
    <logger name="org.hibernate.SQL"            level="DEBUG"/>
    <logger name="org.hibernate.type"           level="WARN"/>

    <!-- Spring Security – WARN u produkciji, DEBUG za debug -->
    <logger name="org.springframework.security" level="WARN"/>

    <!-- Naša aplikacija – INFO po defaultu -->
    <logger name="com.bezbednost.sertifikat"    level="INFO"/>

    <!-- ============================================================
         ROOT LOGGER
    ============================================================ -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>

</configuration>